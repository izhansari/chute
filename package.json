{
  "name": "chute",
  "version": "1.0.0",
  "description": "Chute: toss files and text to people on your network. End-to-end encrypted, gone in a day.",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "setup": "node setup.js",
    "start": "node server.js",
    "desktop": "electron .",
    "icons": "node desktop/make-icons.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "selfsigned": "^2.4.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.chute.desktop",
    "productName": "Chute",
    "artifactName": "Chute-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "dist" },
    "files": [
      "desktop/**/*",
      "lib/**/*",
      "public/**/*",
      "server.js",
      "setup.js",
      "package.json",
      "!desktop/make-icons.js"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "desktop/icons/icon.png",
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "extendInfo": { "LSUIElement": true }
    },
    "win": {
      "icon": "desktop/icons/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "dmg": { "title": "Chute", "contents": [{ "x": 130, "y": 170 }, { "x": 410, "y": 170, "type": "link", "path": "/Applications" }] },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": true },
    "linux": { "target": ["AppImage"], "icon": "desktop/icons/icon.png", "category": "Utility" }
  }
}
