{
  "name": "chute",
  "version": "1.0.2",
  "description": "Chute: toss files and text to people on your network. End-to-end encrypted, gone in a day.",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "setup": "node setup.js",
    "start": "node server.js",
    "desktop": "electron .",
    "icons": "node desktop/make-icons.js",
    "dist": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --win",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:signed": "electron-builder --mac --win"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "selfsigned": "^2.4.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.chute.desktop",
    "productName": "Chute",
    "artifactName": "Chute-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "dist" },
    "files": [
      "desktop/**/*",
      "lib/**/*",
      "public/**/*",
      "server.js",
      "setup.js",
      "package.json",
      "!desktop/make-icons.js"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "desktop/icons/icon.png",
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "extendInfo": { "LSUIElement": true },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "icon": "desktop/icons/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "dmg": {
      "title": "Chute",
      "contents": [
        { "x": 130, "y": 150 },
        { "x": 410, "y": 150, "type": "link", "path": "/Applications" },
        { "x": 270, "y": 300, "type": "file", "path": "build/If macOS says it cannot verify Chute.txt" }
      ]
    },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": true },
    "linux": { "target": ["AppImage"], "icon": "desktop/icons/icon.png", "category": "Utility" }
  }
}
